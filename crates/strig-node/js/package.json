{
  "name": "@the-hades-organization/strig",
  "version": "0.7.0",
  "description": "Strig authorization engine (RBAC, ABAC, ReBAC) for Node, Bun and the browser, with real-time permissions.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/The-Hades-Organization/Strig.git", "directory": "crates/strig-node/js" },
  "bin": { "strig-types": "./dist/types-cli.js" },
  "files": ["dist/", "wasm/", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "deno": "./dist/browser.js",
      "bun": "./dist/node.js",
      "node": "./dist/node.js",
      "default": "./dist/browser.js"
    },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
    "./protocol": { "types": "./dist/protocol.d.ts", "default": "./dist/protocol.js" },
    "./remote": { "types": "./dist/remote.d.ts", "default": "./dist/remote.js" },
    "./express": { "types": "./dist/express.d.ts", "default": "./dist/express.js" },
    "./fastify": { "types": "./dist/fastify.d.ts", "default": "./dist/fastify.js" },
    "./types": { "types": "./dist/types-gen.d.ts", "default": "./dist/types-gen.js" },
    "./nestjs": { "types": "./dist/nestjs.d.ts", "default": "./dist/nestjs.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./angular": { "types": "./dist/angular.d.ts", "default": "./dist/angular.js" },
    "./prisma": { "types": "./dist/prisma.d.ts", "default": "./dist/prisma.js" },
    "./drizzle": { "types": "./dist/drizzle.d.ts", "default": "./dist/drizzle.js" },
    "./kysely": { "types": "./dist/kysely.d.ts", "default": "./dist/kysely.js" },
    "./approvals": { "types": "./dist/approvals.d.ts", "default": "./dist/approvals.js" },
    "./store": { "types": "./dist/store.d.ts", "default": "./dist/store.js" },
    "./testing": { "types": "./dist/testing.d.ts", "default": "./dist/testing.js" }
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.json && ngc -p tsconfig.angular.json && node scripts/copy-types.mjs",
    "build": "sh ../scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "pretest": "npm run build:ts && tsc -p test/tsconfig.json",
    "test": "node dist-test/run.js",
    "pretest:bun": "npm run pretest",
    "test:bun": "bun dist-test/run.js"
  },
  "peerDependencies": {
    "@angular/common": ">=17",
    "@angular/core": ">=17",
    "@nestjs/common": ">=10",
    "drizzle-orm": ">=0.30",
    "express": ">=4",
    "fastify": ">=4",
    "kysely": ">=0.27",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@angular/common": { "optional": true },
    "@angular/core": { "optional": true },
    "@nestjs/common": { "optional": true },
    "drizzle-orm": { "optional": true },
    "express": { "optional": true },
    "fastify": { "optional": true },
    "kysely": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@angular/common": "20.3.35",
    "@angular/compiler": "20.3.35",
    "@angular/compiler-cli": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "@angular/platform-browser-dynamic": "20.3.35",
    "@nestjs/common": "11.0.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/express": "^5.0.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/sql.js": "1.4.9",
    "drizzle-orm": "0.44.7",
    "express": "5.1.0",
    "fastify": "5.2.1",
    "jsdom": "26.1.0",
    "kysely": "0.28.8",
    "pg": "^8.13.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "sql.js": "1.13.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18.17",
    "bun": ">=1.1"
  }
}
