{
  "name": "@the-hades-organization/strig",
  "version": "0.6.1",
  "description": "Strig authorization engine (RBAC, ABAC, ReBAC) for Node, Bun and the browser, with real-time permissions.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/The-Hades-Organization/Strig.git", "directory": "crates/strig-node/js" },
  "files": ["dist/", "wasm/", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "deno": "./dist/browser.js",
      "bun": "./dist/node.js",
      "node": "./dist/node.js",
      "default": "./dist/browser.js"
    },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
    "./protocol": { "types": "./dist/protocol.d.ts", "default": "./dist/protocol.js" },
    "./remote": { "types": "./dist/remote.d.ts", "default": "./dist/remote.js" },
    "./express": { "types": "./dist/express.d.ts", "default": "./dist/express.js" },
    "./fastify": { "types": "./dist/fastify.d.ts", "default": "./dist/fastify.js" },
    "./nestjs": { "types": "./dist/nestjs.d.ts", "default": "./dist/nestjs.js" },
    "./testing": { "types": "./dist/testing.d.ts", "default": "./dist/testing.js" }
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.json && node scripts/copy-types.mjs",
    "build": "sh ../scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "pretest": "npm run build:ts && tsc -p test/tsconfig.json",
    "test": "node dist-test/run.js",
    "pretest:bun": "npm run pretest",
    "test:bun": "bun dist-test/run.js"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "express": ">=4",
    "fastify": ">=4"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "express": { "optional": true },
    "fastify": { "optional": true }
  },
  "devDependencies": {
    "@nestjs/common": "11.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "express": "5.1.0",
    "fastify": "5.2.1",
    "pg": "^8.13.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18.17",
    "bun": ">=1.1"
  }
}
