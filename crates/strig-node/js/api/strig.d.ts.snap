/**
 * Translates a listing into a Prisma `where` for one model. Every atom is total over `null`, so a deny never
 * drops a row it does not reach. Throws {@link OrmFilterError} when the mapping lacks a kind or attribute the
 * filter reads, or the filter has a node with no query form.
 */
export declare function toWhere<P extends string>(filter: ListFilter<P>, mapping: PrismaMapping): OrmFilter<PrismaWhere, P>;
export declare const prisma: OrmAdapter<PrismaWhere, string>;

// ===== protocol.d.ts =====
export interface Anchor {
    kind: string;
    id?: string;
}
export interface Resource {
    path: Anchor[];
    attrs?: Record<string, unknown>;
}
export type ChangeKind = 'grants' | 'tuples' | 'roles' | 'catalog' | 'custom' | 'resync';
export interface Change {
    kind: ChangeKind;
    scope: Anchor;
    subject?: string;
    id?: string;
    origin: string;
    seq: number;
    at: number;
    /** Revision the store gave the write, `scope@value`; absent from older nodes. */
    revision?: string;
}
export type ServerMessage = {
    type: 'hello';
    origin: string;
    subject?: string;
    version?: number;
} | {
    type: 'capabilities';
    scope: Resource;
    set: {
        subject: unknown;
        grants: unknown[];
        withFields?: unknown[];
    };
    /** Revision of the data the set was computed from, `scope@value`. */
    revision?: string;
} | {
    type: 'change';
    change: Change;
} | {
    type: 'resync';
} | {
    type: 'error';
    message: string;
} | {
    type: 'ping';
};
export type ClientMessage = {
    type: 'watch';
    scopes: Resource[];
} | {
    type: 'unwatch';
    scopes: Resource[];
} | {
    type: 'refresh';
} | {
    type: 'refresh_at_least';
    revision: string;
};
export declare const GLOBAL = "global";
/** The protocol version this client and session speak; revisions arrived in 2. */
export declare const PROTOCOL_VERSION = 2;
/** How a revision compares with the one a decision requires. */
export type Reached = 'yes' | 'behind' | 'other_scope' | 'untracked';
/** Splits `scope@value` at the last `@`; `undefined` when it is not a revision. */
export declare function parseRevision(text: string): {
    scope: string;
    value: bigint;
} | undefined;
/** Whether `have` reaches `required`. A missing or malformed `have` is `untracked`, never `yes`. */
export declare function revisionReached(required: string, have: string | undefined): Reached;
export declare function anchorToString(anchor: Anchor): string;
/** `document:d1/project:p1/org:o1`, igual a `strig_sync::scope_to_string`. */
export declare function scopeToString(scope: Resource): string;
export declare function scopeFromString(text: string): Resource;
export declare function sameAnchor(a: Anchor, b: Anchor): boolean;
export declare function resourceContains(resource: Resource, anchor: Anchor): boolean;
/** Mesma regra de `Change::affects` no Rust. */
export declare function changeAffects(change: Change, subjectId: string | null, scope: Resource): boolean;
/** O recurso está sob o escopo: o degrau principal do escopo aparece no caminho do recurso. */
export declare function resourceWithin(resource: Resource, scope: Resource): boolean;
export declare function encodeSse(message: ServerMessage): string;
/** Lê um stream de bytes SSE e chama `onMessage` com cada mensagem JSON. */
export declare function readSse(body: ReadableStream<Uint8Array>, onMessage: (message: ServerMessage) => void): Promise<void>;
export * from './fields.js';

